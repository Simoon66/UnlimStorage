{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Per-user storage plan, token wallet balance, and subscription expiry state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user.",
          "minLength": 1,
          "maxLength": 120
        },
        "planId": {
          "type": "string",
          "description": "Active storage tier identifier.",
          "enum": ["free_25gb", "pro_50gb", "ultra_1tb", "unlimited_admin"],
          "minLength": 1,
          "maxLength": 32
        },
        "tokenBalance": {
          "type": "number",
          "description": "Available storage tokens in the user's wallet."
        },
        "planExpiresAt": {
          "type": "string",
          "description": "ISO timestamp when the active monthly plan expires, or empty string for free plan.",
          "maxLength": 64
        },
        "graceEndsAt": {
          "type": "string",
          "description": "ISO timestamp when the 3-month (90-day) grace period ends after plan expiry.",
          "maxLength": 64
        },
        "usedPromoCodes": {
          "type": "string",
          "description": "Comma-separated list of redeemed promo codes.",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "planId",
        "tokenBalance",
        "planExpiresAt",
        "graceEndsAt",
        "usedPromoCodes",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudFileMeta": {
      "title": "CloudFileMeta",
      "description": "Per-user cloud file metadata and encrypted Telegram chunk manifest isolated by ownerId.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique file identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the file owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of the file owner.",
          "minLength": 1,
          "maxLength": 120
        },
        "folderId": {
          "type": "string",
          "description": "Parent folder ID or 'root'.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "File name.",
          "minLength": 1,
          "maxLength": 255
        },
        "sizeBytes": {
          "type": "number",
          "description": "File size in bytes."
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type of the file.",
          "minLength": 1,
          "maxLength": 128
        },
        "starred": {
          "type": "boolean",
          "description": "Whether the file is starred by the owner."
        },
        "downloadCount": {
          "type": "number",
          "description": "Total number of downloads."
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 integrity hash of the file.",
          "maxLength": 128
        },
        "storageDriver": {
          "type": "string",
          "description": "Storage driver backing the file.",
          "enum": ["telegram", "local_vault"],
          "maxLength": 32
        },
        "telegramChatId": {
          "type": "string",
          "description": "Channel chat ID for Telegram chunk storage.",
          "maxLength": 64
        },
        "telegramChunksJson": {
          "type": "string",
          "description": "Serialized JSON array of TelegramChunk descriptors.",
          "maxLength": 131072
        },
        "previewText": {
          "type": "string",
          "description": "Optional text preview snippet.",
          "maxLength": 30000
        },
        "previewDataUrl": {
          "type": "string",
          "description": "Optional base64 data URL preview for small images.",
          "maxLength": 524288
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when file was uploaded."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when file was last updated."
        }
      },
      "required": [
        "id",
        "ownerId",
        "ownerName",
        "folderId",
        "name",
        "sizeBytes",
        "mimeType",
        "starred",
        "downloadCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudFolderMeta": {
      "title": "CloudFolderMeta",
      "description": "Per-user cloud folder metadata synced across devices.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique folder identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the folder owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of the folder owner.",
          "minLength": 1,
          "maxLength": 120
        },
        "parentId": {
          "type": "string",
          "description": "Parent folder ID or 'root'.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Folder name.",
          "minLength": 1,
          "maxLength": 255
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when folder was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when folder was updated."
        }
      },
      "required": [
        "id",
        "ownerId",
        "ownerName",
        "parentId",
        "name",
        "createdAt",
        "updatedAt"
      ]
    },
    "StorageNodeConfig": {
      "title": "StorageNodeConfig",
      "description": "Admin-configured Telegram storage bridge credentials for cross-device binary persistence.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Configuration document identifier ('global').",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "botToken": {
          "type": "string",
          "description": "Telegram Bot HTTP API token.",
          "maxLength": 256
        },
        "chatId": {
          "type": "string",
          "description": "Private Telegram channel or group chat ID.",
          "maxLength": 64
        },
        "botUsername": {
          "type": "string",
          "description": "Bot username returned by Telegram getMe.",
          "maxLength": 120
        },
        "autoSyncUploads": {
          "type": "boolean",
          "description": "Whether uploads automatically sync to Telegram."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when storage node config was updated."
        }
      },
      "required": [
        "id",
        "botToken",
        "chatId",
        "botUsername",
        "autoSyncUploads",
        "updatedAt"
      ]
    },
    "PublicShareDoc": {
      "title": "PublicShareDoc",
      "description": "Publicly resolvable share link metadata and chunk manifest indexed by shareToken.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique share record identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "token": {
          "type": "string",
          "description": "Public share capability token matching document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileId": {
          "type": "string",
          "description": "Target shared file ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileName": {
          "type": "string",
          "description": "Shared file name.",
          "minLength": 1,
          "maxLength": 255
        },
        "fileSizeBytes": {
          "type": "number",
          "description": "Shared file size in bytes."
        },
        "fileMimeType": {
          "type": "string",
          "description": "Shared file MIME type.",
          "minLength": 1,
          "maxLength": 128
        },
        "fileSha256": {
          "type": "string",
          "description": "Shared file SHA-256 hash.",
          "maxLength": 128
        },
        "creatorId": {
          "type": "string",
          "description": "Firebase Auth UID of the share creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "creatorName": {
          "type": "string",
          "description": "Display name of the share creator.",
          "minLength": 1,
          "maxLength": 120
        },
        "hasPassword": {
          "type": "boolean",
          "description": "Whether the share link requires a password."
        },
        "passwordHash": {
          "type": "string",
          "description": "Hashed password or empty string if public.",
          "maxLength": 128
        },
        "active": {
          "type": "boolean",
          "description": "Whether the share link is currently active."
        },
        "downloadCount": {
          "type": "number",
          "description": "Number of downloads via this link."
        },
        "throttleKbps": {
          "type": "number",
          "description": "Bandwidth speed limit in KB/s (0 for unlimited)."
        },
        "storageDriver": {
          "type": "string",
          "description": "Storage driver backing the shared file.",
          "enum": ["telegram", "local_vault"],
          "maxLength": 32
        },
        "telegramChatId": {
          "type": "string",
          "description": "Telegram channel chat ID for chunk retrieval.",
          "maxLength": 64
        },
        "telegramChunksJson": {
          "type": "string",
          "description": "Serialized JSON array of TelegramChunk descriptors.",
          "maxLength": 131072
        },
        "cloudChunkCount": {
          "type": "number",
          "description": "Number of Firestore binary chunks stored in publicShareChunks."
        },
        "previewText": {
          "type": "string",
          "description": "Optional text preview snippet.",
          "maxLength": 30000
        },
        "previewDataUrl": {
          "type": "string",
          "description": "Optional base64 data URL preview for small images.",
          "maxLength": 524288
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when share was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when share was last updated."
        }
      },
      "required": [
        "id",
        "token",
        "fileId",
        "fileName",
        "fileSizeBytes",
        "fileMimeType",
        "fileSha256",
        "creatorId",
        "creatorName",
        "hasPassword",
        "passwordHash",
        "active",
        "downloadCount",
        "throttleKbps",
        "storageDriver",
        "telegramChatId",
        "telegramChunksJson",
        "cloudChunkCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicShareChunk": {
      "title": "PublicShareChunk",
      "description": "Binary chunk stored in Firestore for cross-device public file downloads.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Chunk document ID ({fileId}_part_{partIndex}).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileId": {
          "type": "string",
          "description": "Parent file ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the file owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "partIndex": {
          "type": "number",
          "description": "Zero-based chunk part index."
        },
        "sizeBytes": {
          "type": "number",
          "description": "Byte length of this chunk."
        },
        "dataBase64": {
          "type": "string",
          "description": "Base64-encoded binary slice.",
          "minLength": 1,
          "maxLength": 980000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when chunk was stored."
        }
      },
      "required": [
        "id",
        "fileId",
        "ownerId",
        "partIndex",
        "sizeBytes",
        "dataBase64",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores each authenticated user's storage plan, token balance, and subscription expiry."
    },
    "/cloudFiles/{fileId}": {
      "schema": {
        "$ref": "#/entities/CloudFileMeta"
      },
      "description": "Stores per-user cloud file metadata and Telegram chunk manifest strictly isolated to the owning user."
    },
    "/cloudFolders/{folderId}": {
      "schema": {
        "$ref": "#/entities/CloudFolderMeta"
      },
      "description": "Stores per-user cloud folder hierarchy strictly isolated to the owning user."
    },
    "/storageNodeConfig/{nodeId}": {
      "schema": {
        "$ref": "#/entities/StorageNodeConfig"
      },
      "description": "Stores admin-configured Telegram storage node credentials for cross-device persistence."
    },
    "/publicShares/{shareToken}": {
      "schema": {
        "$ref": "#/entities/PublicShareDoc"
      },
      "description": "Stores publicly resolvable share links indexed by capability shareToken."
    },
    "/publicShareChunks/{chunkId}": {
      "schema": {
        "$ref": "#/entities/PublicShareChunk"
      },
      "description": "Stores binary chunks in Firestore for direct cross-device public file downloads."
    }
  }
}
